# ── KAPS · пример конфигурации ────────────────────────────────────────────────
# Скопируйте файл в .env и заполните значения. Не коммитьте .env.

# PostgreSQL. Для docker-compose из репозитория: localhost:5432/kaps
DATABASE_URL="postgresql://kaps:kaps@localhost:5432/kaps?schema=public"
APP_URL="http://localhost:3000"

# Секрет для подписи внутренних значений. Сгенерируйте:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="CHANGE_ME"
SESSION_TTL_DAYS="30"

# ── Telegram ──────────────────────────────────────────────────────────────────
# Токен выдаёт @BotFather. Он ИСПОЛЬЗУЕТСЯ ТОЛЬКО НА СЕРВЕРЕ.
TELEGRAM_BOT_TOKEN="123456789:AA..."
# Публичный username бота без @ (нужен для Login Widget)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="kaps_collector_bot"
TELEGRAM_LOGIN_MAX_AGE_SECONDS="86400"
# Telegram ID администраторов и саппортов через запятую (узнать: @userinfobot)
ADMIN_TELEGRAM_IDS=""
SUPPORT_TELEGRAM_IDS=""
# Чат/канал, куда бот отправляет новые обращения (например, -1001234567890)
SUPPORT_CHAT_ID=""

# ── Support key ───────────────────────────────────────────────────────────────
# Ключ хранится только в виде scrypt-хеша. Сгенерируйте хеш командой:
# npm run support:hash -- "ваш-секретный-ключ"
SUPPORT_KEY_HASH=""
SUPPORT_KEY_MAX_ATTEMPTS="5"
SUPPORT_KEY_LOCK_MINUTES="60"

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB="12"

# ── S3-compatible storage (опционально) ───────────────────────────────────────
# Оставьте пустым для локального хранения. Заполните всё для S3/MinIO/R2.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ── OCR / vision ─────────────────────────────────────────────────────────────
OCR_LANGS="eng+rus"
OCR_MIN_CONFIDENCE="30"
OCR_CACHE_DIR="./storage/tesseract"
# Опционально: vision-модель для уточнения распознавания
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_VISION_MODEL="gpt-4o-mini"

# Локальный вход для разработки. В production обязательно false.
ENABLE_DEV_LOGIN="false"